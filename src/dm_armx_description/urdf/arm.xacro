        <mesh filename="package://dm_armx_description/meshes/visual/colored_link4_anodized_grey.stl" /> <!-- 加载氧化灰 STL 网格 -->
      </geometry>                                                    <!-- 几何形状块结束 -->
      <material name="anodized_grey" />                              <!-- 使用 anodized_grey 材质 -->
    </visual>                                                        <!-- 可视化元素结束 -->
    <collision>                                                      <!-- 碰撞体定义块开始 -->
      <origin xyz="0 0 0" rpy="0 0 0" />                             <!-- 碰撞体相对 link 原点无变换 -->
      <geometry>                                                     <!-- 几何形状块开始 -->
        <mesh filename="package://dm_armx_description/meshes/collision/link4.STL" />            <!-- 加载碰撞检测用 STL 网格 -->
      </geometry>                                                    <!-- 几何形状块结束 -->
    </collision>                                                     <!-- 碰撞体定义块结束 -->
  </link>                                                            <!-- 连杆 link4 定义结束 -->
  <joint name="joint4" type="revolute">                              <!-- 定义关节：joint4，旋转关节（腕旋转） -->
    <origin xyz="0.2426 -0.054 -0.001625" rpy="0 0 0" />             <!-- 相对父 link：沿 X 24.26cm 等偏移 -->
