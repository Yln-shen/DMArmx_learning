<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">                                       <!-- 机器人根节点，模型名称为 ReBot_Arm_DM -->

  <link name="base_link">                                            <!-- 定义连杆：基座 base_link -->
    <inertial>                                                       <!-- 惯性参数块开始 -->
      <origin xyz="-7.849E-06 -1.1531E-06 0.029841" rpy="0 0 0" />   <!-- 质心相对 link 原点：几乎在原点上方 2.98cm -->
      <mass value="0.83660000" />                                    <!-- 质量：0.8366 kg -->
      <inertia ixx="0.00133040" ixy="0.00000001" ixz="0.00000000" iyy="0.00213119" iyz="0.00000000" izz="0.00275877" /> <!-- 惯性张量 6 个分量 -->
    </inertial>                                                      <!-- 惯性参数块结束 -->
    <visual name="base_link_silver_trim">                            <!-- 可视化元素：银色装饰部分 -->
      <origin xyz="0 0 0" rpy="0 0 0" />                             <!-- 相对 link 原点无平移无旋转 -->
      <geometry>                                                     <!-- 几何形状块开始 -->
        <mesh filename="package://dm_armx_description/meshes/visual/colored_base_link_silver_trim.stl" /> <!-- 加载银色 STL 网格 -->
      </geometry>                                                    <!-- 几何形状块结束 -->
      <material name="silver_trim" />                                <!-- 使用 silver_trim 材质 -->
    </visual>                                                        <!-- 可视化元素结束 -->
    <visual name="base_link_hardware_black">                         <!-- 可视化元素：五金件黑色部分 -->
      <origin xyz="0 0 0" rpy="0 0 0" />                             <!-- 相对 link 原点无变换 -->
      <geometry>                                                     <!-- 几何形状块开始 -->
        <mesh filename="package://dm_armx_description/meshes/visual/colored_base_link_hardware_black.stl" /> <!-- 加载五金黑 STL 网格 -->
      </geometry>                                                    <!-- 几何形状块结束 -->
      <material name="hardware_black" />                             <!-- 使用 hardware_black 材质 -->
    </visual>                                                        <!-- 可视化元素结束 -->
    <visual name="base_link_matte_black">                            <!-- 可视化元素：哑光黑部分 -->
      <origin xyz="0 0 0" rpy="0 0 0" />                             <!-- 相对 link 原点无变换 -->
      <geometry>                                                     <!-- 几何形状块开始 -->
        <mesh filename="package://dm_armx_description/meshes/visual/colored_base_link_matte_black.stl" /> <!-- 加载哑光黑 STL 网格 -->
      </geometry>                                                    <!-- 几何形状块结束 -->
      <material name="matte_black" />                                <!-- 使用 matte_black 材质 -->
    </visual>                                                        <!-- 可视化元素结束 -->
    <collision>                                                      <!-- 碰撞体定义块开始 -->
      <origin xyz="0 0 0" rpy="0 0 0" />                             <!-- 碰撞体相对 link 原点无变换 -->
      <geometry>                                                     <!-- 几何形状块开始 -->
        <mesh filename="package://dm_armx_description/meshes/collision/base_link.STL" />        <!-- 加载碰撞检测用 STL 网格 -->
      </geometry>                                                    <!-- 几何形状块结束 -->
    </collision>                                                     <!-- 碰撞体定义块结束 -->
  </link>                                                            <!-- 连杆 base_link 定义结束 -->


  <link name="link1">                                                <!-- 定义连杆：link1（第 1 轴） -->
    <inertial>                                                       <!-- 惯性参数块开始 -->
      <origin xyz="0.000113614552951627 -0.000616319527051323 0.0236476372671394" rpy="0 0 0" /> <!-- 质心偏移 -->
      <mass value="0.16130000" />                                    <!-- 质量：0.1613 kg -->
      <inertia ixx="0.00025207" ixy="0.00000000" ixz="-0.00002832" iyy="0.00015464" iyz="0.00000000" izz="0.00023416" /> <!-- 惯性张量 -->
    </inertial>                                                      <!-- 惯性参数块结束 -->
    <visual name="link1_matte_black">                                <!-- 可视化元素：哑光黑部分 -->
      <origin xyz="0 0 0" rpy="0 0 0" />                             <!-- 相对 link 原点无变换 -->
      <geometry>                                                     <!-- 几何形状块开始 -->
        <mesh filename="package://dm_armx_description/meshes/visual/colored_link1_matte_black.stl" /> <!-- 加载哑光黑 STL 网格 -->
      </geometry>                                                    <!-- 几何形状块结束 -->
      <material name="matte_black" />                                <!-- 使用 matte_black 材质 -->
    </visual>                                                        <!-- 可视化元素结束 -->
    <visual name="link1_hardware_black">                             <!-- 可视化元素：五金件黑部分 -->
      <origin xyz="0 0 0" rpy="0 0 0" />                             <!-- 相对 link 原点无变换 -->
      <geometry>                                                     <!-- 几何形状块开始 -->
        <mesh filename="package://dm_armx_description/meshes/visual/colored_link1_hardware_black.stl" /> <!-- 加载五金黑 STL 网格 -->
      </geometry>                                                    <!-- 几何形状块结束 -->
      <material name="hardware_black" />                             <!-- 使用 hardware_black 材质 -->
    </visual>                                                        <!-- 可视化元素结束 -->
    <visual name="link1_anodized_grey">                              <!-- 可视化元素：阳极氧化灰部分 -->
      <origin xyz="0 0 0" rpy="0 0 0" />                             <!-- 相对 link 原点无变换 -->
      <geometry>                                                     <!-- 几何形状块开始 -->
        <mesh filename="package://dm_armx_description/meshes/visual/colored_link1_anodized_grey.stl" /> <!-- 加载氧化灰 STL 网格 -->
      </geometry>                                                    <!-- 几何形状块结束 -->
      <material name="anodized_grey" />                              <!-- 使用 anodized_grey 材质 -->
    </visual>                                                        <!-- 可视化元素结束 -->
    <collision>                                                      <!-- 碰撞体定义块开始 -->
      <origin xyz="0 0 0" rpy="0 0 0" />                             <!-- 碰撞体相对 link 原点无变换 -->
      <geometry>                                                     <!-- 几何形状块开始 -->
        <mesh filename="package://dm_armx_description/meshes/collision/link1.STL" />            <!-- 加载碰撞检测用 STL 网格 -->
      </geometry>                                                    <!-- 几何形状块结束 -->
    </collision>                                                     <!-- 碰撞体定义块结束 -->
  </link>                                                            <!-- 连杆 link1 定义结束 -->

  <joint name="joint1" type="revolute">                              <!-- 定义关节：joint1，旋转关节 -->
    <origin xyz="-8.416E-05 0 0.08465" rpy="0 0 0" />                <!-- 关节相对父 link 的位姿：Z 上移 8.465cm -->
    <parent link="base_link" />                                      <!-- 父连杆：base_link -->
    <child link="link1" />                                           <!-- 子连杆：link1 -->
    <axis xyz="0 0 1" />                                             <!-- 旋转轴：Z 轴 -->
    <limit lower="-2.8" upper="2.8" effort="27" velocity="50" />     <!-- 限位：±2.8rad，力矩 27N·m，速度 50rad/s -->
  </joint>                                                           <!-- 关节 joint1 定义结束 -->


  <link name="link2">                                                <!-- 定义连杆：link2（第 2 轴，大臂） -->
    <inertial>                                                       <!-- 惯性参数块开始 -->
      <origin xyz="-0.13225622308888 -0.0030617036386309 -0.0308306967030205" rpy="0 0 0" /> <!-- 质心偏移 -->
      <mass value="1.32660000" />                                    <!-- 质量：1.3266 kg（最重连杆） -->
      <inertia ixx="0.00073374" ixy="-0.00000043" ixz="0.00000851" iyy="0.01255987" iyz="0.00000128" izz="0.01281387" /> <!-- 惯性张量 -->
    </inertial>                                                      <!-- 惯性参数块结束 -->
    <visual name="link2_seeed_yellow">                               <!-- 可视化元素：Seeed 黄色部分 -->
      <origin xyz="0 0 0" rpy="0 0 0" />                             <!-- 相对 link 原点无变换 -->
      <geometry>                                                     <!-- 几何形状块开始 -->
        <mesh filename="package://dm_armx_description/meshes/visual/colored_link2_seeed_yellow.stl" /> <!-- 加载黄色 STL 网格 -->
      </geometry>                                                    <!-- 几何形状块结束 -->
      <material name="seeed_yellow" />                               <!-- 使用 seeed_yellow 材质 -->
    </visual>                                                        <!-- 可视化元素结束 -->
    <visual name="link2_matte_black">                                <!-- 可视化元素：哑光黑部分 -->
      <origin xyz="0 0 0" rpy="0 0 0" />                             <!-- 相对 link 原点无变换 -->
      <geometry>                                                     <!-- 几何形状块开始 -->
        <mesh filename="package://dm_armx_description/meshes/visual/colored_link2_matte_black.stl" /> <!-- 加载哑光黑 STL 网格 -->
      </geometry>                                                    <!-- 几何形状块结束 -->
      <material name="matte_black" />                                <!-- 使用 matte_black 材质 -->
    </visual>                                                        <!-- 可视化元素结束 -->
    <visual name="link2_hardware_black">                             <!-- 可视化元素：五金件黑部分 -->
      <origin xyz="0 0 0" rpy="0 0 0" />                             <!-- 相对 link 原点无变换 -->
