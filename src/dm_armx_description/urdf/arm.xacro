      <material name="matte_black" />                                <!-- 使用 matte_black 材质 -->
    </visual>                                                        <!-- 可视化元素结束 -->
    <visual name="link6_hardware_black">                             <!-- 可视化元素：五金件黑部分 -->
      <origin xyz="0 0 0" rpy="0 0 0" />                             <!-- 相对 link 原点无变换 -->
