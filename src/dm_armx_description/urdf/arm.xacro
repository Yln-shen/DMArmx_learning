    </collision>                                                     <!-- 碰撞体定义块结束 -->
  </link>                                                            <!-- 连杆 link6 定义结束 -->

  <joint name="joint6" type="revolute">                              <!-- 定义关节：joint6，旋转关节（末端旋转） -->
    <origin xyz="0.028008 0 0.04" rpy="0 1.5708 0" />                <!-- 相对父 link 位姿：绕 Y 轴 +90° -->
    <parent link="link5" />                                          <!-- 父连杆：link5 -->
