      <geometry>                                                     <!-- 几何形状块开始 -->
        <mesh filename="package://dm_armx_description/meshes/collision/link3.STL" />            <!-- 加载碰撞检测用 STL 网格 -->
      </geometry>                                                    <!-- 几何形状块结束 -->
    </collision>                                                     <!-- 碰撞体定义块结束 -->
  </link>                                                            <!-- 连杆 link3 定义结束 -->
  

  <joint name="joint3" type="revolute">                              <!-- 定义关节：joint3，旋转关节（肘部） -->
    <origin xyz="-0.264 0 0" rpy="0 0 0" />                          <!-- 相对父 link：沿 -X 平移 26.4cm（大臂长） -->
    <parent link="link2" />                                          <!-- 父连杆：link2 -->
