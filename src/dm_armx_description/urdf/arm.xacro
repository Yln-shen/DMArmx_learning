      </geometry>                                                    <!-- 几何形状块结束 -->
      <material name="hardware_black" />                             <!-- 使用 hardware_black 材质 -->
    </visual>                                                        <!-- 可视化元素结束 -->
    <visual name="link2_anodized_grey">                              <!-- 可视化元素：阳极氧化灰部分 -->
      <origin xyz="0 0 0" rpy="0 0 0" />                             <!-- 相对 link 原点无变换 -->
      <geometry>                                                     <!-- 几何形状块开始 -->
        <mesh filename="package://dm_armx_description/meshes/visual/colored_link2_anodized_grey.stl" /> <!-- 加载氧化灰 STL 网格 -->
      </geometry>                                                    <!-- 几何形状块结束 -->
      <material name="anodized_grey" />                              <!-- 使用 anodized_grey 材质 -->
    </visual>                                                        <!-- 可视化元素结束 -->
    <collision>                                                      <!-- 碰撞体定义块开始 -->
      <origin xyz="0 0 0" rpy="0 0 0" />                             <!-- 碰撞体相对 link 原点无变换 -->
      <geometry>                                                     <!-- 几何形状块开始 -->
        <mesh filename="package://dm_armx_description/meshes/collision/link2.STL" />            <!-- 加载碰撞检测用 STL 网格 -->
      </geometry>                                                    <!-- 几何形状块结束 -->
    </collision>                                                     <!-- 碰撞体定义块结束 -->
  </link>                                                            <!-- 连杆 link2 定义结束 -->


  <joint name="joint2" type="revolute">                              <!-- 定义关节：joint2，旋转关节（肩部） -->
    <origin xyz="0.020084 0.031625 0.05555" rpy="-1.5708 0 0" />     <!-- 相对父 link 位姿：绕 X 轴 -90° -->
    <parent link="link1" />                                          <!-- 父连杆：link1 -->
    <child link="link2" />                                           <!-- 子连杆：link2 -->
    <axis xyz="0 0 -1" />                                            <!-- 旋转轴：负 Z 轴（经父坐标系旋转后对应世界 Y） -->
    <limit lower="-3.14" upper="0.02" effort="27" velocity="50" />    <!-- 限位：-π~0，上限留 0.02rad 余量吸收零位噪声 -->
  </joint>                                                           <!-- 关节 joint2 定义结束 -->


  <link name="link3">                                                <!-- 定义连杆：link3（第 3 轴，小臂） -->
