    </collision>                                                     <!-- 碰撞体定义块结束 -->
  </link>                                                            <!-- 连杆 link5 定义结束 -->


  <joint name="joint5" type="revolute">                              <!-- 定义关节：joint5，旋转关节（腕俯仰） -->
    <origin xyz="0.078308 -0.0375 -0.03" rpy="-1.5708 0 0" />        <!-- 相对父 link 位姿：绕 X 轴 -90° -->
    <parent link="link4" />                                          <!-- 父连杆：link4 -->
    <child link="link5" />                                           <!-- 子连杆：link5 -->
    <axis xyz="0 0 1" />                                             <!-- 旋转轴：Z 轴 -->
    <limit lower="-1.57" upper="1.57" effort="7" velocity="200" />   <!-- 限位：±1.57rad，力矩 7N·m，速度 200rad/s -->
  </joint>                                                           <!-- 关节 joint5 定义结束 -->


