      </geometry>                                                    <!-- 几何形状块结束 -->
      <material name="matte_black" />                                <!-- 此处材质应为 seeed_yellow，疑似笔误 -->
    </visual>                                                        <!-- 可视化元素结束 -->
    <visual name="link4_matte_black">                                <!-- 可视化元素：哑光黑部分 -->
      <origin xyz="0 0 0" rpy="0 0 0" />                             <!-- 相对 link 原点无变换 -->
