  </link>                                                            <!-- 连杆 link2 定义结束 -->


  <joint name="joint2" type="revolute">                              <!-- 定义关节：joint2，旋转关节（肩部） -->
    <origin xyz="0.020084 0.031625 0.05555" rpy="-1.5708 0 0" />     <!-- 相对父 link 位姿：绕 X 轴 -90° -->
    <parent link="link1" />                                          <!-- 父连杆：link1 -->
