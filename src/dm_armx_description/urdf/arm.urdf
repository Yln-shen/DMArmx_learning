      </geometry>                                                    <!-- 几何形状块结束 -->
      <material name="hardware_black" />                             <!-- 使用 hardware_black 材质 -->
    </visual>                                                        <!-- 可视化元素结束 -->
    <visual name="link1_anodized_grey">                              <!-- 可视化元素：阳极氧化灰部分 -->
      <origin xyz="0 0 0" rpy="0 0 0" />                             <!-- 相对 link 原点无变换 -->
      <geometry>                                                     <!-- 几何形状块开始 -->
        <mesh filename="package://dm_armx_description/meshes/visual/colored_link1_anodized_grey.stl" /> <!-- 加载氧化灰 STL 网格 -->
      </geometry>                                                    <!-- 几何形状块结束 -->
      <material name="anodized_grey" />                              <!-- 使用 anodized_grey 材质 -->
    </visual>                                                        <!-- 可视化元素结束 -->
    <collision>                                                      <!-- 碰撞体定义块开始 -->
      <origin xyz="0 0 0" rpy="0 0 0" />                             <!-- 碰撞体相对 link 原点无变换 -->
