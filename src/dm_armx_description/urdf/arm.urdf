<?xml version='1.0' encoding='utf-8'?>                              <!-- XML 声明：版本 1.0，编码 UTF-8 -->
<robot name="ReBot_Arm_DM">                                          <!-- 机器人根节点，模型名称为 ReBot_Arm_DM -->


  <material name="gripper_finger_black">                             <!-- 定义材质：夹爪手指黑色 -->
    <color rgba="0.066667 0.074510 0.070588 1" />                    <!-- RGBA 颜色：深黑，不透明 -->
  </material>                                                        <!-- 材质定义结束 -->

  <material name="gripper_carriage_grey">                            <!-- 定义材质：夹爪滑架灰色 -->
    <color rgba="0.239 0.278 0.271 1" />                             <!-- RGBA：深灰绿色，不透明 -->
  </material>                                                        <!-- 材质定义结束 -->

  <material name="gripper_rack_metal">                               <!-- 定义材质：夹爪齿条金属色 -->
    <color rgba="0.831373 0.847059 0.831373 1" />                    <!-- RGBA：浅金属灰，不透明 -->
  </material>                                                        <!-- 材质定义结束 -->

  <material name="gripper_seeed_yellow">                             <!-- 定义材质：夹爪 Seeed 黄色 -->
    <color rgba="0.725 0.835 0.118 1" />                             <!-- RGBA：品牌黄绿色，不透明 -->
  </material>                                                        <!-- 材质定义结束 -->

  <material name="gripper_hardware_black">                           <!-- 定义材质：夹爪五金件黑色 -->
    <color rgba="0.019608 0.027451 0.023529 1" />                    <!-- RGBA：近纯黑，不透明 -->
  </material>                                                        <!-- 材质定义结束 -->


  <material name="gripper_base_metal">                               <!-- 定义材质：夹爪底座金属色 -->
    <color rgba="0.831373 0.847059 0.831373 1" />                    <!-- RGBA：浅金属灰，不透明 -->
  </material>                                                        <!-- 材质定义结束 -->

  <material name="anodized_grey">                                    <!-- 定义材质：阳极氧化灰 -->
    <color rgba="0.831373 0.847059 0.831373 1" />                    <!-- RGBA：浅金属灰，不透明 -->
  </material>                                                        <!-- 材质定义结束 -->

  <material name="silver_trim">                                      <!-- 定义材质：银色装饰 -->
    <color rgba="0.878431 0.890196 0.874510 1" />                    <!-- RGBA：银色，不透明 -->
  </material>                                                        <!-- 材质定义结束 -->

  <material name="seeed_yellow">                                     <!-- 定义材质：Seeed 主黄色 -->
    <color rgba="0.73 0.84 0.12 1" />                                <!-- RGBA：品牌黄绿色，不透明 -->
  </material>                                                        <!-- 材质定义结束 -->

  <material name="matte_black">                                      <!-- 定义材质：哑光黑 -->
    <color rgba="0.066667 0.074510 0.070588 1" />                    <!-- RGBA：深黑，不透明 -->
  </material>                                                        <!-- 材质定义结束 -->

  <material name="hardware_black">                                   <!-- 定义材质：五金件黑 -->
    <color rgba="0.019608 0.027451 0.023529 1" />                    <!-- RGBA：近纯黑，不透明 -->
  </material>                                                        <!-- 材质定义结束 -->



  <link name="base_link">                                            <!-- 定义连杆：基座 base_link -->
    <inertial>                                                       <!-- 惯性参数块开始 -->
      <origin xyz="-7.849E-06 -1.1531E-06 0.029841" rpy="0 0 0" />   <!-- 质心相对 link 原点：几乎在原点上方 2.98cm -->
      <mass value="0.83660000" />                                    <!-- 质量：0.8366 kg -->
      <inertia ixx="0.00133040" ixy="0.00000001" ixz="0.00000000" iyy="0.00213119" iyz="0.00000000" izz="0.00275877" /> <!-- 惯性张量 6 个分量 -->
    </inertial>                                                      <!-- 惯性参数块结束 -->
    <visual name="base_link_silver_trim">                            <!-- 可视化元素：银色装饰部分 -->
      <origin xyz="0 0 0" rpy="0 0 0" />                             <!-- 相对 link 原点无平移无旋转 -->
      <geometry>                                                     <!-- 几何形状块开始 -->
        <mesh filename="package://dm_armx_description/meshes/visual/colored_base_link_silver_trim.stl" /> <!-- 加载银色 STL 网格 -->
      </geometry>                                                    <!-- 几何形状块结束 -->
      <material name="silver_trim" />                                <!-- 使用 silver_trim 材质 -->
    </visual>                                                        <!-- 可视化元素结束 -->
    <visual name="base_link_hardware_black">                         <!-- 可视化元素：五金件黑色部分 -->
